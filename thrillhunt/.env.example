# ---- core ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:3000
APP_SECRET=change-me-to-32-plus-random-bytes
COOKIE_SECURE=false
DATABASE_FILE=./db/thrillhunt.db
STORAGE_DIR=./storage

# ---- providers (all default to safe local mocks) ----
PAYMENT_PROVIDER=mock              # mock | stripe
IMAGE_MODERATION_PROVIDER=mock     # mock | rekognition
LLM_PROVIDER=mock                  # mock | anthropic
STORAGE_PROVIDER=local             # local | s3
MAPS_PROVIDER=osm                  # osm | google | mapbox

# ---- Stripe (only when PAYMENT_PROVIDER=stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---- Anthropic (only when LLM_PROVIDER=anthropic) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- AWS (only when STORAGE_PROVIDER=s3 or moderation=rekognition) ----
AWS_REGION=us-east-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
